# ---------------------------------------------------------------------------- #
# EMBEDDINGS · basta UNA de las dos claves. Si están las dos, gana Google.
# ---------------------------------------------------------------------------- #
# El proveedor se elige mirando qué clave está definida aquí (ver
# embeddings.resolve_embedder). Lo usan los splitters SEMÁNTICOS, la etapa de
# indexación y el pipeline de ingesta, todo vía LlamaIndex. Con las dos claves
# puedes elegir el modelo en la UI o con el campo `embedder` de /ingest.
#
# ⚠️ Los espacios vectoriales NO son compatibles entre proveedores ni entre
# dimensiones: si cambias de modelo, hay que RE-EMBEBER las colecciones ya
# creadas (o borrarlas). La ingesta lo detecta y avisa antes de embeber.

# Opción A · Google · gemini-embedding-2 (768/1536/3072 dims, asimétrico).
# Consíguela gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Opción B · OpenAI · text-embedding-3-small (512/1024/1536 dims, simétrico).
# Consíguela en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Etapa de Vector Store: servidor Qdrant (fuerza bruta exacta vs. ANN/HNSW).
# QDRANT_API_KEY es opcional según tu despliegue.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Necesaria SOLO para el Document Loader "LlamaParse" (el mejor).
# Consíguela gratis en https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-...

# Necesaria SOLO para el Document Loader "SmartPDFLoader".
# Levanta el servicio con Docker:
#   docker run -p 5010:5010 ghcr.io/nlmatics/nlm-ingestor:latest
LLMSHERPA_API_URL=http://localhost:5010/api/parseDocument?renderFormat=all
