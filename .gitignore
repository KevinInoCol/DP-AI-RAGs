# Secretos — nunca subir claves reales, usar los .env.example como plantilla
.env
.env.*
!.env.example

# Datos generados por los scripts 01_setup.py / 03_embeddings.py.
# Se conserva la carpeta (via .gitkeep) pero no su contenido.
**/data/*
!**/data/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store
